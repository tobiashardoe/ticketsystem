@startuml TicketSystem_ER_Diagram

title TicketSystem – ER-diagram
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #52606D
skinparam EntityBorderColor #52606D
skinparam EntityBackgroundColor #F8FAFC
skinparam EntityFontColor #172B4D

entity "users" as users {
    id
    --
    name
    email
    role
    passwordHash
}

entity "tickets" as tickets {
    id
    --
    created_by_id
    assigned_to_id
    title
    description
    status
    priority
}

entity "comments" as comments {
    id
    --
    ticket_id
    author_id
    message
}

entity "attachments" as attachments {
    id
    --
    ticket_id
    fileName
    fileType
    filePath
}

users ||--o{ tickets : createdBy
users |o--o{ tickets : assignedTo

tickets ||--o{ comments : ticket
users ||--o{ comments : author
tickets ||--o{ attachments : ticket


@enduml
